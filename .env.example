# Salin file ini menjadi ".env" lalu isi nilai sebenarnya. JANGAN commit ".env".

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=ganti-dengan-secret-key-acak
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Biarkan baris ini di-comment untuk fallback ke sqlite lokal saat development.
# Contoh production: DATABASE_URL=postgres://user:pass@host:5432/qlibrary
# DATABASE_URL=

# Object storage (S3-compatible - Cloudflare R2 / Backblaze B2)
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_BASE_URL=http://localhost:3000

# Email provider (django-anymail) untuk OTP 2FA & undangan admin
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=noreply@qlibrary.example.com

OTP_LIFETIME_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

ADMIN_INVITE_LIFETIME_DAYS=3
